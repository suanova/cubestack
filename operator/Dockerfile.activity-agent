# Build the activity-agent binary, the DevEnvironment idle-timeout sidecar.
#
# A near-copy of the manager's Dockerfile, and deliberately so: the same bases,
# the same mirror build args, the same static build. What differs is the
# command and the binary, and the fact that this image is run as the
# environment's own account rather than as the manager's fixed uid — see the
# USER at the bottom.
#
# Both bases are build args defaulting to upstream. The e2e overrides them with
# the platform registry's copies (see BASE_MIRRORS in the Makefile) so its pulls
# do not go to Docker Hub and GCR; leaving them as the defaults keeps a bare
# `make docker-build-activity-agent` — and any build outside the platform's
# network — working.
#
# Both must be declared before the first FROM. An ARG declared after one is
# scoped to that stage, and the second FROM then expands to a blank base name —
# "base name (${DISTROLESS_BASE}) should not be blank".
#
# The golang base is pinned to a patch version, not to the 1.27 line: go.mod
# requires go 1.27.1 (envoyproxy/ai-gateway v1.2.0), and a base older than that
# makes the build download a toolchain at build time.
ARG GOLANG_BASE=golang:1.27.1
ARG DISTROLESS_BASE=gcr.io/distroless/static:nonroot
FROM ${GOLANG_BASE} AS builder
ARG TARGETOS
ARG TARGETARCH
# Use the goproxy.cn module mirror (the default proxy.golang.org is
# unreachable from this network without a proxy). Override with
# --build-arg GOPROXY=... if needed.
ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=${GOPROXY}

WORKDIR /workspace
# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum
# cache deps before building and copying source so we don't need to re-download as much
# and so that source changes don't invalidate our downloaded layer
RUN go mod download

# Copy the Go source (relies on .dockerignore to filter)
COPY . .

# Build
# the GOARCH has no default value to allow the binary to be built according to the host where the command
# was called. For example, if we call make docker-build in a local env which has the Apple Silicon M1 SO
# the docker BUILDPLATFORM arg will be linux/arm64 when for Apple x86 it will be linux/amd64.
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o activity-agent cmd/activity-agent/main.go

# Use distroless as minimal base image to package the agent binary
# Refer to https://github.com/GoogleContainerTools/distroless for more details
FROM ${DISTROLESS_BASE}
WORKDIR /
COPY --from=builder /workspace/activity-agent .
# The uid here is a fallback, not a decision. The controller runs the sidecar as
# the environment's own account, because /proc/<pid>/io is readable only by a
# process that shares the identity of the one it is reading — running as 65532
# beside a pod whose user is 1000 would silently cost the agent the IO
# dimension, which is the one that catches a training job using almost no CPU.
USER 65532:65532

ENTRYPOINT ["/activity-agent"]
